ScoutCoder=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
 workflow.rb
 start_chat
 chats=chats filter="*"{
  delete
  workflow
  claude

  implement

  version_2

  version_2.task_doc
  version_2.task_doc.analyze

  version_2.helpers
  version_2.entities
  version_2.python

 }
 lib=lib {
  ScoutCoder=ScoutCoder{
   helper_test_support.rb
   task_test_support.rb
   tasks=tasks{
    document_task.rb
    documentation.rb
    entity_tools.rb
    helper_tools.rb
    list_entities.rb
    task_test_tools.rb
    workflow_tools.rb
   }
  }
 }
 share=share{
  tasks=tasks{
  }
 }

 bin=bin{
  clean_prompts.rb
 }

 test=test {
  test_helper.rb
 }
 README.md
 LICENSE
}
