ScoutCoder=/$PWD filter="*.rb *.rake Rakefile *.rdoc *.R *.sh *.js *.haml *.sass *.txt *.conf *.slim *.haml" {
 workflow.rb
 start_chat
 chats=chats filter="*"{
  delete
  workflow
  claude

  implement

  version_2

  version_2.task_doc
  version_2.task_doc.analyze

  version_2.entities

 }
 lib=lib {
  ScoutCoder=ScoutCoder{
   task_test_support.rb
   tasks=tasks{
    documentation.rb
    workflow_tools.rb
   }
  }
 }
 share=share{
  tasks=tasks{
  }
 }

 bin=bin{
  clean_prompts.rb
 }

 test=test {
  test_helper.rb
 }
 README.md
 LICENSE
}
